MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sólo para los procesos locales protegidos que llaman a import-source-catalog.
CATALOG_INGEST_TOKEN=
# Puente HTTPS privado hacia SQL Server. Nunca usar prefijo NEXT_PUBLIC_.
SQL_SERVER_PROXY_URL=https://pladisel.es/utils/sql-server-proxy/sql-server-proxy.php
SQL_SERVER_PROXY_TOKEN=
SHOPIFY_STORE_URL=electronica-vicente.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# Sólo para desarrollo local de la Edge Function. En producción se configura
# como secreto de Supabase, nunca como variable NEXT_PUBLIC ni en Vercel.
ICECAT_USERNAME=
ICECAT_APP_KEY=
ICECAT_LANGUAGE=es
MHD_API_URL=https://www.mihogardigital.es
MHD_API_VERSION=v1
MHD_API_SUB_PATH=evicente
MHD_API_USER=
MHD_API_PASS=

# Chatbot (Supabase de chatbot-vicente, solo servidor)
CHATBOT_SUPABASE_URL=
CHATBOT_SUPABASE_SECRET_KEY=
CHATBOT_ADMIN_SECRET=
# Proxy de Icecat en el servidor de Pladisel (IP fija autorizada en Icecat). Vacío = llamada directa.
ICECAT_PROXY_URL=
ICECAT_PROXY_TOKEN=
# Proxy de Garantía3 en el servidor de Pladisel (IP autorizada). El token de Garantía3 se queda en ese servidor.
GARANTIA3_PROXY_URL=
GARANTIA3_PROXY_TOKEN=
GARANTIA3_TOKEN=
GARANTIA3_TOKEN_TEST=
